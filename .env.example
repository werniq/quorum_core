# Quorum environment example
# Copy to .env and set secrets before `docker compose up`.

# Credential KEK: supply via secret mechanism. Back up separately from the database file.
QUORUM_CREDENTIAL_KEK=replace-with-long-random-secret
# QUORUM_CREDENTIAL_KEK_PREVIOUS=optional-previous-key-during-rotation
# Optional distinct key for outcome identifier HMAC (otherwise derived from KEK).
# QUORUM_IDENTIFIER_HMAC_KEY=replace-with-another-long-secret

# HTML UI login/setup. Default false: open the catalog without registration for local try-out.
# Set true before any shared or production deploy.
QUORUM_UI_AUTH_ENABLED=false
# Required only when QUORUM_UI_AUTH_ENABLED=true (>= 24 characters). Invalidated after first admin.
# QUORUM_SETUP_TOKEN=replace-with-one-time-setup-token-min-24

PUBLIC_BASE_URL=http://127.0.0.1:3000
# Optional host publish port when 3000 is already in use:
# QUORUM_HOST_PORT=3000

# Metrics disabled by default. When enabled, set a bearer token (or use loopback only).
# METRICS_ENABLED=false
# METRICS_AUTH_TOKEN=

# Dedicated worker intervals
# OUTBOX_INTERVAL_MS=15000
# N8N_POLL_SCHEDULER_INTERVAL_MS=15000
