{
  "name": "quorum",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage:cadence": "vitest run --coverage tests/domain/cadence-evaluator.test.ts tests/domain/cadence-deadline.test.ts",
    "test:cov": "vitest run --coverage tests/domain/cadence-evaluator.test.ts tests/domain/cadence-deadline.test.ts tests/domain/reliability-health.test.ts tests/domain/evidence-level-policy.test.ts tests/domain/release-gate-coverage.test.ts",
    "test:repository": "vitest run tests/repositories",
    "test:migrations": "vitest run tests/migrations",
    "test:security": "vitest run tests/security tests/release",
    "test:integration": "vitest run tests/integration",
    "test:milestone:1": "vitest run tests/domain tests/migrations tests/repositories tests/architecture tests/contracts",
    "test:milestone:2": "vitest run tests/ingestion tests/infrastructure",
    "test:milestone:3": "vitest run tests/watcher tests/integration tests/n8n tests/contracts",
    "test:self-hosted": "vitest run tests/self-hosted",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:compose": "node scripts/verify-clean-compose.mjs",
    "test:restart": "node scripts/verify-restart-persistence.mjs",
    "test:e2e:n8n": "node scripts/verify-n8n-e2e.mjs",
    "test:e2e:n8n:real": "node scripts/verify-real-n8n-validation.mjs",
    "verify:self-hosted": "node scripts/verify-self-hosted.mjs",
    "security:deps": "npm audit --omit=dev --audit-level=high",
    "release:check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:integration && npm run test:repository && npm run test:migrations && npm run test:security && npm run test:cov && npm run build",
    "db:generate:sqlite": "drizzle-kit generate --config=drizzle.sqlite.config.ts",
    "db:generate:postgres": "drizzle-kit generate --config=drizzle.postgres.config.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cron-parser": "^5.3.0",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.4.0",
    "pg": "^8.16.3",
    "ulid": "^2.3.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@eslint/js": "^9.31.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.14",
    "@types/pg": "^8.15.4",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "vitest": "^3.2.4"
  }
}
